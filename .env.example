# Appointment form -> /api/cita -> Resend (https://resend.com)
# Server-only secrets: NO "PUBLIC_" prefix, so they never reach the browser.

# API key with "Sending access" (Resend dashboard -> API Keys)
RESEND_API_KEY=re_your_api_key_here

# Where appointment requests are delivered (default: info@almavetjerez.com)
CONTACT_TO_EMAIL=info@almavetjerez.com

# Sender. The domain must be verified in Resend.
# (default: "Almavet Jerez Reservas <citas@almavetjerez.com>")
CONTACT_FROM_EMAIL="Almavet Jerez Reservas <citas@almavetjerez.com>"

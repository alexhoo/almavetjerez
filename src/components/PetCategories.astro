---
import { site, petCategories } from "~/data/site";
import PetCategoryChip from "./PetCategoryChip.astro";
---

<section id="clinica" class="py-16 md:py-24 bg-brand-navy scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: image -->
      <div class="rounded-3xl overflow-hidden aspect-[716/572] shadow-2xl shadow-black/30">
        <img
          src={site.petCategoriesSection.imagePath}
          alt={site.petCategoriesSection.imageAlt}
          width="716"
          height="572"
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Right: text + chips + values -->
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-4">
          <p class="text-xs font-bold uppercase tracking-widest text-brand-lavender">
            {site.petCategoriesSection.eyebrow}
          </p>
          <h2
            class="font-display text-3xl md:text-4xl font-extrabold text-white leading-tight tracking-tight"
          >
            {site.petCategoriesSection.title}
          </h2>
          <p class="text-base text-white/70 leading-relaxed">
            {site.petCategoriesSection.description}
          </p>
        </div>

        <!-- Category chips -->
        <div class="flex flex-wrap gap-3">
          {
            petCategories.map((cat) => (
              <PetCategoryChip icon={cat.icon} label={cat.label} />
            ))
          }
        </div>

        <!-- Values -->
        <dl
          class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 border-t border-white/10"
        >
          {
            site.petCategoriesSection.values.map((v) => (
              <div class="flex flex-col gap-1">
                <dt class="font-display font-bold text-white text-base">{v.title}</dt>
                <dd class="text-xs text-white/60 leading-snug">{v.desc}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

---
import { site } from "~/data/site";
---

<section aria-label="Llamada a la acción" class="relative overflow-hidden bg-gradient-to-br from-brand-blue to-brand-blue-600 py-16 md:py-24">
  <!-- Decorative glow -->
  <div aria-hidden="true" class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-96 h-96 rounded-full bg-white/10 blur-3xl"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-6 text-center text-white flex flex-col items-center gap-6">
    <h2 class="text-3xl md:text-4xl font-bold leading-tight">
      {site.cta.title}
    </h2>
    <p class="text-base md:text-lg text-white/80 max-w-2xl leading-relaxed">
      {site.cta.description}
    </p>
    <div class="flex flex-wrap justify-center gap-4 pt-2">
      <a
        href={site.cta.primaryCta.href}
        class="inline-flex items-center px-8 py-3 rounded-xl bg-white text-brand-blue font-semibold text-sm hover:bg-brand-sky transition-colors shadow-sm"
      >
        {site.cta.primaryCta.label}
      </a>
      <a
        href={`tel:${site.phoneTel}`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border-2 border-white/60 text-white font-semibold text-sm hover:border-white hover:bg-white/10 transition-colors"
      >
        Llamar: {site.phone}
      </a>
    </div>
  </div>
</section>

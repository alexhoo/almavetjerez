---
import { site } from "~/data/site";
import Icon from "./Icon.astro";
---

<section aria-label="Llamada a la acción" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div
      class="relative overflow-hidden rounded-3xl bg-brand-blue-600 px-8 py-12 md:px-16 md:py-16"
    >
      <!-- Decorative paws -->
      <Icon
        name="paw"
        class="absolute -bottom-6 right-8 w-28 h-28 text-white/10 rotate-12"
      />
      <Icon
        name="paw"
        class="absolute bottom-16 right-40 w-16 h-16 text-white/10 -rotate-12"
      />

      <div
        class="relative grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 items-center text-white"
      >
        <div class="flex flex-col gap-4 max-w-lg">
          <h2 class="font-display text-3xl md:text-4xl font-extrabold leading-tight tracking-tight">
            {site.cta.title}
          </h2>
          <p class="text-base text-white/80 leading-relaxed">
            {site.cta.description}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={site.cta.primaryCta.href}
            class="inline-flex items-center px-6 py-3 rounded-full bg-white text-brand-blue font-bold text-sm hover:bg-brand-sky transition-colors shadow-sm"
          >
            {site.cta.primaryCta.label}
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            class="inline-flex items-center px-6 py-3 rounded-full border border-white/50 bg-white/10 text-white font-bold text-sm hover:bg-white/20 transition-colors"
          >
            Llamar: {site.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

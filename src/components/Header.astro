---
import { site } from "~/data/site";
import { MobileNav } from "./react/MobileNav";

const navItems = site.nav.map((item) => ({
  label: item.label,
  href: item.href,
}));
---

<header
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200/60"
>
  <div
    class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-4"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-4 shrink-0 group"
      aria-label="Almavet Jerez — Inicio"
    >
      <img
        src="/images/logo-almavetjerez.svg"
        alt="Almavet Jerez"
        class="w-72 h-auto"
      />
    </a>

    <!-- Desktop nav -->
    <nav
      aria-label="Navegación principal"
      class="hidden md:flex items-center gap-8"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-md font-medium text-brand-slate hover:text-brand-navy transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA + Mobile menu -->
    <div class="flex items-center gap-3">
      <a
        href={site.hero.primaryCta.href}
        class="hidden md:inline-flex items-center px-5 py-2 rounded-full bg-brand-blue text-white text-sm font-semibold hover:bg-brand-blue-600 transition-colors"
      >
        {site.hero.primaryCta.label}
      </a>

      <!-- Mobile nav island (React) -->
      <MobileNav
        client:load
        navItems={navItems}
        ctaHref={site.hero.primaryCta.href}
        ctaLabel={site.hero.primaryCta.label}
      />
    </div>
  </div>
</header>

---
import Icon from "./Icon.astro";
import type { IconName } from "~/types/icons";

interface Props {
  icon: IconName;
  label: string;
}
const { icon, label } = Astro.props;
---

<div
  class="flex items-center gap-2 bg-white/5 rounded-full px-4 py-2 border border-white/20"
>
  <Icon name={icon} class="w-4 h-4 text-brand-lavender" />
  <span class="text-sm font-semibold text-white">{label}</span>
</div>

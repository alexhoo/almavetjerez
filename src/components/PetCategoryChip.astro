---
import Icon from "./Icon.astro";
import type { IconName } from "~/types/icons";

interface Props {
  icon: IconName;
  label: string;
}
const { icon, label } = Astro.props;
---

<div class="flex items-center gap-2 bg-white rounded-full px-4 py-2 shadow-sm border border-slate-200/60">
  <Icon name={icon} class="w-5 h-5 text-brand-blue" />
  <span class="text-sm font-semibold text-brand-navy">{label}</span>
</div>

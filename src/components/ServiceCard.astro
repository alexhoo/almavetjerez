---
import Icon from "./Icon.astro";
import type { IconName } from "~/types/icons";

interface Props {
  icon: IconName;
  title: string;
  desc: string;
}
const { icon, title, desc } = Astro.props;
---

<div
  class="flex flex-col gap-4 p-6 bg-brand-mist rounded-2xl border border-slate-200/70 hover:shadow-lg hover:-translate-y-0.5 transition-all group"
>
  <div
    class="flex items-center justify-center w-11 h-11 rounded-xl bg-white text-brand-blue shadow-sm group-hover:bg-brand-blue group-hover:text-white transition-colors"
  >
    <Icon name={icon} class="w-5 h-5" />
  </div>
  <h3 class="font-display font-bold text-brand-navy text-lg leading-snug tracking-tight">
    {title}
  </h3>
  <p class="text-sm text-brand-slate leading-relaxed">{desc}</p>
</div>

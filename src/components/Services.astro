---
import { site, services } from "~/data/site";
import ServiceCard from "./ServiceCard.astro";
---

<section id="servicios" aria-labelledby="servicios-title" class="py-16 md:py-24 bg-brand-sky">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="flex flex-col items-center text-center gap-4 mb-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-blue">
        ● {site.servicesSection.eyebrow}
      </p>
      <h2 id="servicios-title" class="text-3xl md:text-4xl font-bold text-brand-navy">
        {site.servicesSection.title}
      </h2>
      <!-- Decorative underline -->
      <div class="w-12 h-1 rounded-full bg-brand-blue"></div>
    </div>

    <!-- Services grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {services.map((service) => (
        <ServiceCard icon={service.icon} title={service.title} desc={service.desc} />
      ))}
    </div>

  </div>
</section>

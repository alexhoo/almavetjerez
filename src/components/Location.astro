---
import { site } from "~/data/site";
import Icon from "./Icon.astro";
---

<section
  id="ubicacion"
  aria-labelledby="ubicacion-title"
  class="py-16 md:py-24 bg-brand-mist scroll-mt-20"
>
  <div class="max-w-6xl mx-auto px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-brand-purple mb-3">
      {site.locationSection.eyebrow}
    </p>
    <h2
      id="ubicacion-title"
      class="font-display text-3xl md:text-4xl font-extrabold text-brand-navy tracking-tight mb-10"
    >
      {site.locationSection.title}
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-6">
      <!-- Map -->
      <div
        class="relative min-h-[320px] lg:min-h-[420px] rounded-3xl overflow-hidden bg-slate-200 border border-slate-200/70"
      >
        <iframe
          title={`Mapa de ${site.address.street}, ${site.address.city}`}
          src={site.locationSection.mapEmbedUrl}
          class="absolute inset-0 w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>

      <!-- Info card -->
      <div
        class="flex flex-col gap-6 bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-200/60"
      >
        <div class="flex flex-col gap-4">
          <h3 class="font-display font-bold text-brand-navy text-lg tracking-tight">
            Horario de atención
          </h3>
          <dl class="flex flex-col gap-3 text-sm">
            {
              site.hours.map((h) => (
                <div class="flex items-start justify-between gap-4 pb-3 border-b border-slate-100">
                  <dt class="font-medium text-brand-navy">{h.days}</dt>
                  <dd class="text-brand-slate text-right">
                    {h.ranges.map((r) => (
                      <span class="block">{r.replace(/ – /g, "-")}</span>
                    ))}
                  </dd>
                </div>
              ))
            }
            <div class="flex items-start justify-between gap-4">
              <dt class="font-medium text-brand-navy">Domingos</dt>
              <dd class="text-brand-slate">Cerrado</dd>
            </div>
          </dl>
        </div>

        <div class="flex flex-col gap-2">
          <h3 class="font-display font-bold text-brand-navy text-lg tracking-tight">
            Contacto directo
          </h3>
          <a
            href={`tel:${site.phoneTel}`}
            class="font-bold text-brand-navy hover:text-brand-blue transition-colors"
          >
            {site.phone}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="text-sm text-brand-blue hover:underline"
          >
            {site.email}
          </a>
        </div>

        <a
          href={site.locationSection.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full border border-slate-300/80 text-brand-navy font-bold text-sm hover:border-brand-blue hover:text-brand-blue transition-colors"
        >
          <Icon name="map" class="w-4 h-4 text-brand-blue" />
          Cómo llegar en Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

---
import { site } from "~/data/site";
import InfoCard from "./InfoCard.astro";
import Icon from "./Icon.astro";
---

<section id="ubicacion" aria-labelledby="ubicacion-title" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      <!-- Left: info cards -->
      <div class="flex flex-col gap-8">
        <h2 id="ubicacion-title" class="text-3xl md:text-4xl font-bold text-brand-navy">
          {site.locationSection.title}
        </h2>

        <div class="flex flex-col gap-6">
          <InfoCard icon="map-pin" title="Nuestra Clínica">
            <p>{site.address.street}</p>
            <p>{site.address.zip}, {site.address.city}</p>
          </InfoCard>

          <InfoCard icon="clock" title="Horario de Atención">
            {site.hours.map((h) => (
              <p>{h.days}</p>
              <p>{h.ranges.join(" y ")}</p>
            ))}
          </InfoCard>

          <InfoCard icon="phone" title="Contacto Directo">
            <p>
              <a href={`tel:${site.phoneTel}`} class="hover:text-brand-blue transition-colors">
                {site.phone}
              </a>
            </p>
            <p>
              <a href={`mailto:${site.email}`} class="hover:text-brand-blue transition-colors">
                {site.email}
              </a>
            </p>
          </InfoCard>
        </div>
      </div>

      <!-- Right: image with overlay card -->
      <div class="relative rounded-2xl overflow-hidden aspect-[4/3]">
        <img
          src={site.locationSection.imagePath}
          alt={site.locationSection.imageAlt}
          width="600"
          height="450"
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <!-- Overlay card: "¿Cómo llegar?" -->
        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] bg-white rounded-xl shadow-xl p-5 flex flex-col items-center gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-sky text-brand-blue">
            <Icon name="map" class="w-5 h-5" />
          </div>
          <p class="font-semibold text-brand-navy text-sm">¿Cómo llegar?</p>
          <a
            href={site.locationSection.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-blue text-white text-sm font-semibold hover:bg-brand-blue-600 transition-colors"
          >
            Ver en Google Maps
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

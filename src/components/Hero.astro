---
import { site } from "~/data/site";
import Icon from "./Icon.astro";
---

<section class="bg-brand-mist pt-10 pb-24 md:pt-16 md:pb-28">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: copy -->
      <div class="flex flex-col gap-6 items-start">
        <!-- Eyebrow -->
        <p
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-slate-200/70 text-[11px] font-bold uppercase tracking-wider text-brand-purple"
        >
          <Icon name="heart" class="w-3 h-3" />
          {site.hero.eyebrow}
        </p>

        <!-- Headline -->
        <h1
          class="font-display text-5xl md:text-6xl font-extrabold text-brand-navy leading-[1.02] tracking-tight"
        >
          {site.hero.titleLine1}<br />
          {site.hero.titleLine2Prefix}<span class="text-brand-blue"
            >{site.hero.titleLine2Accent}</span
          >
        </h1>

        <!-- Description -->
        <p class="text-base md:text-lg text-brand-slate leading-relaxed max-w-md">
          {site.hero.description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={site.hero.primaryCta.href}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-blue text-white font-bold text-sm hover:bg-brand-blue-600 transition-colors shadow-lg shadow-brand-blue/25"
          >
            {site.hero.primaryCta.label}
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
          <a
            href={`tel:${site.phoneTel}`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border border-slate-300/70 text-brand-navy font-bold text-sm hover:border-brand-blue hover:text-brand-blue transition-colors"
          >
            <Icon name="phone" class="w-4 h-4 text-brand-blue" />
            {site.hero.secondaryCta.label}
          </a>
        </div>

        <!-- Trust checks -->
        <ul class="flex flex-wrap gap-x-6 gap-y-2 pt-2">
          {
            site.hero.checks.map((check) => (
              <li class="flex items-center gap-2 text-xs font-medium text-brand-slate">
                <Icon name="check" class="w-3.5 h-3.5 text-brand-blue" />
                {check}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right: image + chips -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none lg:ml-auto">
        <!-- Lavender offset plate -->
        <div
          aria-hidden="true"
          class="absolute inset-0 translate-x-4 translate-y-4 md:translate-x-5 md:translate-y-5 rounded-3xl bg-brand-lavender/50"
        >
        </div>
        <img
          src={site.hero.imagePath}
          alt={site.hero.imageAlt}
          width="1055"
          height="1024"
          class="relative block w-full aspect-[1055/1024] object-cover rounded-3xl shadow-xl"
          loading="eager"
          decoding="async"
        />

        <!-- Lab results chip -->
        <div
          class="absolute top-4 right-3 md:-right-4 flex items-center gap-3 bg-white rounded-2xl px-4 py-3 shadow-lg"
        >
          <div
            class="flex items-center justify-center w-8 h-8 rounded-lg bg-brand-sky text-brand-blue"
          >
            <Icon name="flask" class="w-4 h-4" />
          </div>
          <p class="text-xs font-bold text-brand-navy leading-tight max-w-[110px]">
            {site.hero.chip}
          </p>
        </div>

        <!-- Years badge -->
        <div
          class="absolute -bottom-4 -left-3 md:-left-8 flex items-center gap-3 bg-white rounded-2xl px-5 py-4 shadow-lg"
        >
          <p class="font-display text-4xl font-extrabold text-brand-blue leading-none tracking-tight">
            {site.hero.badge.metric}
          </p>
          <p class="text-xs font-medium text-brand-slate leading-tight max-w-[80px]">
            {site.hero.badge.label}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

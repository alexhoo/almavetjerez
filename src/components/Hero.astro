---
import { site } from "~/data/site";
import Icon from "./Icon.astro";
---

<section class="bg-brand-sky pt-8 pb-16 md:pt-16 md:pb-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left: copy -->
      <div class="flex flex-col gap-6">
        <!-- Eyebrow -->
        <p
          class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-blue"
        >
          <Icon name="bullet" class="w-2 h-2" />
          {site.hero.eyebrow}
        </p>

        <!-- Headline -->
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-brand-navy leading-tight"
        >
          {site.hero.titleLine1}<br />
          <span class="text-brand-navy">{site.hero.titleLine2Prefix}</span><span
            class="relative inline-block text-brand-blue"
          >
            {site.hero.titleLine2Accent}
            <!-- Decorative underline SVG -->
            <svg
              aria-hidden="true"
              class="absolute -bottom-2 left-0 w-full"
              viewBox="0 0 200 12"
              preserveAspectRatio="none"
              fill="none"
            >
              <path
                d="M2 8 Q50 2 100 8 Q150 14 198 6"
                stroke="#2b7fff"
                stroke-width="3"
                stroke-linecap="round"
                fill="none"
                opacity="0.5"></path>
            </svg>
          </span>
        </h1>

        <!-- Description -->
        <p
          class="text-base md:text-lg text-brand-slate leading-relaxed max-w-lg"
        >
          {site.hero.description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href={site.hero.primaryCta.href}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-blue text-white font-semibold text-sm hover:bg-brand-blue-600 transition-colors shadow-sm"
          >
            {site.hero.primaryCta.label}
          </a>
          <a
            href={site.hero.secondaryCta.href}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border-2 border-brand-blue text-brand-blue font-semibold text-sm hover:bg-brand-sky transition-colors"
          >
            {site.hero.secondaryCta.label}
          </a>
        </div>
      </div>

      <!-- Right: image + badge -->
      <div class="relative">
        <div
          class="relative rounded-3xl overflow-hidden shadow-xl border-4 border-white rotate-3"
        >
          <div class="absolute inset-0 z-0 bg-brand-sky" aria-hidden="true">
          </div>
          <img
            src={site.hero.imagePath}
            alt={site.hero.imageAlt}
            width="600"
            height="450"
            class="relative z-20 block w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
          <div
            class="pointer-events-none absolute inset-0 z-10 bg-linear-to-t from-brand-navy via-brand-blue to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
        <!-- Badge -->
        <div
          class="absolute -bottom-6 -left-4 md:-left-8 bg-brand-lavender rounded-2xl px-5 py-4 shadow-lg border-4 border-white"
        >
          <p class="text-3xl font-bold text-white leading-none">
            {site.hero.badge.metric}
          </p>
          <p
            class="text-xs font-medium text-white mt-1 max-w-[100px] leading-tight"
          >
            {site.hero.badge.label}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
